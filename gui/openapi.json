            "format": "int32",
            "type": "integer"
          },
          "goalDepth": {
            "format": "int32",
            "type": "integer"
          },
          "goalHeight": {
            "format": "int32",
            "type": "integer"
          },
          "goalSubstitutionAreaWidth": {
            "format": "int32",
