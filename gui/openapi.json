              "clipping_tolerance": {
                "default": 10,
                "description": "Reloaded live, within a second. Unit: mm.",
                "minimum": 0,
                "type": "number"
              },
              "geometry_tolerance": {
                "default": 10,
                "description": "Takes effect when vision_processor restarts. Unit: mm.",
                "minimum": 0,
                "type": "number"
              },
              "min_cam_edge_distance": {
                "default": 170,
                "description": "Reloaded live, within a second. Unit: mm.",
                "minimum": 0,
                "type": "number"
              },
              "min_confidence": {
                "default": 0.2,
                "description": "Reloaded live, within a second.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "resampling_factor": {
                "default": 1,
                "description": "Reloaded live, within a second. Unit: ×.",
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "score": {
                "default": 5,
                "description": "Reloaded live, within a second.",
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "tracking": {
            "properties": {
              "max_bot_acceleration": {
                "default": 6.5,
                "description": "Reloaded live, within a second. Unit: m/s².",
                "minimum": 0,
                "type": "number"
              },
              "min_tracking_radius": {
                "default": 20,
                "description": "Reloaded live, within a second. Unit: mm.",
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "ConfigSlot": {
        "description": "A camera's place in the layout: its camera_id out of the camera count, which together decide the region it covers.",
        "properties": {
          "cameraCount": {
            "type": "integer"
          },
          "cameraId": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ConfigState": {
        "description": "The store's status as the GUI sees it.",
        "properties": {
          "cameras": {
            "items": {
              "$ref": "#/components/schemas/ConfigCameraStatus"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "changes": {
            "description": "What saving would write: disk -\u003e working.",
            "items": {
              "$ref": "#/components/schemas/ConfigChange"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "external": {
            "$ref": "#/components/schemas/ConfigExternalState",
            "description": "Set while the file on disk differs from what was last loaded or saved."
          },
          "path": {
            "type": "string"
          },
          "renderErrors": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "revision": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ConfigTeamOverride": {
        "description": "A team's robot height when it isn't (rightly) in the height table: another table entry's (Name), or a custom Height. Neither set means a custom height not entered yet.",
        "properties": {
          "height": {
            "type": [
              "null",
              "number"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ConfigTeams": {
        "description": "Overrides robot heights by team. Keyed by the game controller's team name, as vision_processor's height table is, so an override follows its team through a color switch (the game controller swaps the whole team record, name included, between colors).",
        "properties": {
          "byColor": {
            "$ref": "#/components/schemas/ConfigColorOverrides",
            "description": "Each color's height off a competition field, where there's usually no game controller to name the teams."
          },
          "overrides": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ConfigTeamOverride"
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "ConfigWarning": {
        "description": "One problem worth surfacing on a camera, with a stable code the frontend can key UI (e.g. a \"rescale corners\" button) off.",
