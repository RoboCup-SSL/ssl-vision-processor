{
  "openapi": "3.1.0",
  "info": {
    "title": "vision_processor GUI host",
    "description": "The GUI host's control API: the shared vision.yml document, its state, and what the host's\nsockets hear. Every error is JSON, `{\"error\": code, \"message\": text, \"issues\": [...]}`; clients branch on\n`error`. Request bodies must be JSON and unknown keys are rejected.\n\n## Live updates\n\n`/ws` is a WebSocket carrying topics. Send `{\"action\": \"subscribe\", \"topic\": \"...\"}` (or\n`unsubscribe`); each message is `{\"topic\": \"...\", \"data\": ...}`. A new subscriber gets the latest value at\nonce. A message the host can't act on is answered with an error and the connection stays open. Each topic's data\nis the body of a REST endpoint documented here:\n\n| Topic | Same as |\n| --- | --- |\n| `config.state` | `state` in GET /api/config |\n| `network.state` | GET /api/network |\n| `alerts.state` | GET /api/alerts |\n| `wrapper_packet.out` | GET /api/geometry |\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/alerts": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Lists every problem the host sees right now, most serious first: alerts.state on demand",
        "description": "",
        "operationId": "getAlerts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AlertsAlert"
                  },
                  "type": "array"
                }
              }
            }
          },
          "500": {
            "description": "error: internal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpjsonErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "Configuration"
        ],
        "summary": "Serves the working document and the store's state",
        "description": "Its revision is also the ETag, for PATCH's If-Match.",
        "operationId": "getConfig",
        "responses": {
          "200": {
            "description": "The working document plus the store's state.",
            "headers": {
              "ETag": {
                "style": "simple",
                "description": "A document revision, quoted as an ETag: \"12\".",
                "schema": {
                  "description": "A document revision, quoted as an ETag: \"12\".",
                  "examples": [
                    "\"12\""
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          },
          "500": {
            "description": "error: internal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpjsonErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Configuration"
        ],
        "summary": "Applies a JSON Merge Patch (RFC 7396) to the working document and applies it live, for clients that change a few keys rather than resending the whole document",
        "description": "A stale If-Match is a 409, like PUT's stale revision.",
        "operationId": "patchConfig",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "description": "The revision the patch is based on, as GET /api/config's ETag gives it.",
            "required": true,
            "schema": {
              "description": "The revision the patch is based on, as GET /api/config's ETag gives it.",
              "examples": [
                "\"12\""
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Merged into the working document's JSON: objects merge, null removes a key, arrays (cameras) are replaced whole.",
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": {},
                "type": "object"
              }
            },
            "application/merge-patch+json": {
              "schema": {
                "additionalProperties": {},
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Answers a config write with the revision it left the working document at.",
            "headers": {
              "ETag": {
                "style": "simple",
                "description": "A document revision, quoted as an ETag: \"12\".",
                "schema": {
                  "description": "A document revision, quoted as an ETag: \"12\".",
                  "examples": [
                    "\"12\""
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevisionResponse"
                }
              }
            }
          },
          "400": {
            "description": "error: bad_request, invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpjsonErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "error: stale",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpjsonErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "error: unsupported_media",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpjsonErrorBody"
                }
              }
            }
          },
          "428": {
            "description": "error: precondition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpjsonErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "error: internal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpjsonErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlertsAlert": {
        "description": "One problem.",
        "properties": {
          "cameraId": {
            "type": [
              "null",
              "integer"
            ]
          },
          "code": {
            "type": "string"
          },
          "id": {
            "description": "Stable while the problem lasts, for keyed lists.",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "params": {
            "additionalProperties": {},
            "description": "The facts the alert is about, named per code.",
            "type": "object"
          },
          "severity": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ConfigCalibration": {
        "description": "A locked SSL_GeometryCameraCalibration, published in place of whatever the camera's vision_processor last sent.",
        "properties": {
          "camera": {
            "additionalProperties": {},
            "description": "SSL_GeometryCameraCalibration in protojson (proto field names).",
            "type": [
              "object",
              "null"
            ]
          },
          "fieldHash": {
            "description": "Identifies the field dimensions the calibration was solved against; a mismatch means the field changed since locking.",
            "type": "string"
          },
          "lockedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ConfigCamera": {
        "description": "One vision_processor instance, keyed by camera_id (its position on the field), not by which machine runs it.",
        "properties": {
          "calibration": {
            "$ref": "#/components/schemas/ConfigCalibration"
          },
          "cameraId": {
            "type": "integer"
          },
          "config": {
            "$ref": "#/components/schemas/ConfigSettings",
            "description": "Overrides Defaults, same config.yml layout, deep-merged."
          },
          "configPath": {
            "description": "A host-local config.yml to regenerate from this document for a vision_processor on the same machine. Empty for remote instances.",
            "type": "string"
          },
          "display": {
            "$ref": "#/components/schemas/ConfigDisplay",
            "description": "How the GUI shows this camera's video. Never rendered."
          },
          "instance": {
            "type": "string"
          },
          "seed": {
            "$ref": "#/components/schemas/ConfigSeed"
          }
        },
        "type": "object"
      },
      "ConfigCameraStatus": {
        "description": "Everything about a camera derived from the document plus the live network state -- never stored.",
        "properties": {
          "calibration": {
            "type": "string"
          },
          "cameraId": {
            "type": "integer"
          },
          "live": {
            "additionalProperties": {},
            "description": "The latest calibration received from the network (proto field names), whether or not one is locked -- what \"Lock\" would store.",
            "type": "object"
          },
          "liveResolution": {
            "description": "The image size the live calibration was solved at, [0, 0] if unknown.",
            "items": {
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/ConfigWarning"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ConfigChange": {
        "description": "One leaf-level difference between two documents. Before or After is nil when the value was added or removed. Lists (e.g. line_corners) are compared as a whole, not element by element.",
        "properties": {
          "after": {},
          "before": {},
          "cameraId": {
            "type": [
              "null",
              "integer"
            ]
          },
          "jsonPath": {
            "type": "string"
          },
          "path": {
            "description": "In vision.yml's spelling (field.field_width), JSONPath in the JSON document's (field.fieldWidth). In both, cameras[N] is the camera with camera_id N, not a list index.",
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ConfigColorOverrides": {
        "description": "A height choice per color.",
        "properties": {
          "blue": {
            "$ref": "#/components/schemas/ConfigTeamOverride"
          },
          "yellow": {
            "$ref": "#/components/schemas/ConfigTeamOverride"
          }
        },
        "type": "object"
      },
      "ConfigDisplay": {
        "description": "Orients a camera's video in the GUI to match the field, since a camera can be mounted at any angle.",
        "properties": {
          "mirror": {
            "type": "boolean"
          },
          "rotate": {
            "description": "degrees clockwise: 0, 90, 180, 270",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ConfigDocument": {
        "description": "One vision.yml.",
        "properties": {
          "cameras": {
            "items": {
              "$ref": "#/components/schemas/ConfigCamera"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "competitionField": {
            "description": "A match setup, with a game controller, rather than casual lab use. The GUI keys height choices by team and raises missing setup to errors; vision_processor doesn't read it.",
            "type": "boolean"
          },
          "defaults": {
            "$ref": "#/components/schemas/ConfigSettings",
            "description": "Uses vision_processor's own config.yml layout (camera:, geometry:, color:, thresholds:, ...) and applies to every camera."
          },
          "field": {
            "$ref": "#/components/schemas/GeometryFieldConfig"
          },
          "host": {
            "$ref": "#/components/schemas/ConfigHost",
            "description": "Settings for this GUI host alone; no vision_processor reads it."
          },
          "layout": {
            "$ref": "#/components/schemas/ConfigLayout"
          },
          "models": {
            "additionalProperties": {},
            "description": "SSL_GeometryModels in protojson (proto field names).",
            "type": "object"
          },
          "optionalFieldLines": {
            "$ref": "#/components/schemas/GeometryOptionalLinesConfig"
          },
          "teams": {
            "$ref": "#/components/schemas/ConfigTeams",
            "description": "Overrides robot heights by team. Shown in the GUI only for now: vision_processor still looks heights up in bot_heights_file by game controller team name."
          },
          "version": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ConfigExternalState": {
        "description": "Describes a change made to the file on disk by something else. Changes are what loading it would do to the working document.",
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/components/schemas/ConfigChange"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ConfigHost": {
        "description": "Settings that only mean something on the machine running the GUI host, such as its network interface names.",
        "properties": {
          "interfaces": {
            "$ref": "#/components/schemas/ConfigInterfaces"
          }
        },
        "type": "object"
      },
      "ConfigInterfaces": {
        "description": "Chooses which network interfaces the host's sockets use.",
        "properties": {
          "auto": {
            "description": "(the default when unset) lets the host pick. Skip is then kept only so switching back to manual restores it.",
            "type": [
              "null",
              "boolean"
            ]
          },
          "skip": {
            "description": "Names interfaces not to use when choosing manually.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ConfigLayout": {
        "description": "How the field is split between cameras.",
        "properties": {
          "cameraCount": {
            "description": "The number of regions the field is split into (vision_processor's geometry.camera_amount). It can exceed the number of cameras, leaving some regions uncovered.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ConfigResponse": {
        "description": "The working document plus the store's state.",
        "properties": {
          "document": {
            "$ref": "#/components/schemas/ConfigDocument"
          },
          "state": {
            "$ref": "#/components/schemas/ConfigState"
          }
        },
        "type": "object"
      },
      "ConfigSeed": {
        "description": "The human-picked calibration starting point: the four field line corners in image pixels, and the image resolution they were picked at. Resolution [0, 0] means unknown (e.g. imported from a legacy config.yml).",
        "properties": {
          "goalSideMarker": {
            "description": "Records which corner-picker marker (1-4) was chosen as the goal-side corner. vision_processor never reads it.",
            "type": "integer"
          },
          "lineCorners": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "resolution": {
            "items": {
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "slot": {
            "$ref": "#/components/schemas/ConfigSlot",
            "description": "The slot the corners were picked for. Moving the camera to another slot makes them stale. Nil for corners saved before slots were recorded."
          }
        },
        "type": "object"
      },
      "ConfigSettings": {
        "description": "vision_processor's config.yml layout, as GET /api/schema describes it. A key it doesn't read is kept but raises an unknown_setting warning.",
        "properties": {
          "bot_heights_file": {
            "default": "robot-heights.yml",
            "description": "Takes effect when vision_processor restarts.",
            "type": "string"
          },
          "cam_id": {
            "description": "Written by the host from the document; don't set it.",
            "readOnly": true,
            "type": "integer"
          },
          "camera": {
            "properties": {
              "driver": {
                "default": "SPINNAKER",
                "description": "Takes effect when vision_processor restarts.",
                "enum": [
                  "SPINNAKER",
                  "MVIMPACT",
                  "OPENCV"
                ],
                "type": "string"
              },
              "exposure": {
                "default": 0,
                "description": "Takes effect when vision_processor restarts.",
                "minimum": 0,
                "type": "number"
              },
              "gain": {
                "default": 0,
                "description": "Takes effect when vision_processor restarts.",
                "minimum": 0,
                "type": "number"
              },
              "gamma": {
                "default": 1,
                "description": "Takes effect when vision_processor restarts.",
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "height": {
