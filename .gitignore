# Config files are local: only the read-only references in config/ are
# tracked (see config/README.md). Copy one to the repo root and edit the copy;
# git ignores it wherever it lives, so `git add -A` can't sweep in a venue's
# config or calibration.
*.yml
!/config/**/*.yml
# Not configs: test fixtures, CI, and vision_processor's default robot height
# table, which it reads from the working directory.
!**/testdata/**/*.yml
!/.gitlab-ci.yml
!/.github/**/*.yml
!/robot-heights.yml

